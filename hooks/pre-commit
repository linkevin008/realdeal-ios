#!/usr/bin/env bash
set -euo pipefail

SIM_NAME="iPhone 17 Pro"
OS_VERSION="26.4.1"
PROJECT="RealDeal.xcodeproj"

echo "==> Building iOS app..."
xcodebuild -project "$PROJECT" \
    -scheme RealDeal \
    -destination "platform=iOS Simulator,name=${SIM_NAME},OS=${OS_VERSION}" \
    -configuration Debug \
    -derivedDataPath /tmp/realdeal-build \
    build \
    2>&1 | tail -5

echo "==> OK"
